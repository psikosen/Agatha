# GSAD Dashboard — Required API Keys
# Copy this file to .env and fill in your keys.

# NASA FIRMS fire data (free registration: https://firms.modaps.eosdis.nasa.gov/api/)
FIRMS_MAP_KEY=

# Finnhub stock/market data (free tier: https://finnhub.io/)
FINNHUB_API_KEY=

# FRED economic data (free: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Backend port (default 3001)
# BACKEND_PORT=3001

# Path to frontend build directory (default ../frontend/dist)
# FRONTEND_DIST=../frontend/dist

# Ollama API base URL (default http://localhost:11434)
# OLLAMA_URL=http://localhost:11434
